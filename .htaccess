# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppType node
PassengerStartupFile server.js
PassengerBaseURI /crm
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

# Allow All CORS Headers at LiteSpeed Web Server Level
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH"
    Header always set Access-Control-Allow-Headers "x-auth-token, X-Auth-Token, authorization, Authorization, Content-Type, Accept, Origin, X-Requested-With, X-CSRF-Token, *"
    Header always set Access-Control-Allow-Credentials "true"
</IfModule>

# LiteSpeed Web Server Intercept for OPTIONS Preflights
RewriteEngine On
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ - [R=200,L]

# Pass Authorization Header to Passenger
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteCond %{REQUEST_URI} ^/crm [NC]
RewriteRule ^ - [L]
